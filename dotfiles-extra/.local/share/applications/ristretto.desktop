[Desktop Entry]
Name=Ristretto Image Viewer
Comment=Fast and light image viewer
Exec=ristretto %U
Icon=ristretto
Terminal=false
Type=Application
Categories=Graphics;Viewer;
MimeType=image/bmp;image/gif;image/jpeg;image/jpg;image/pjpeg;image/png;image/tiff;image/webp;image/x-bmp;image/x-png;image/x-tiff;image/x-webp;image/svg+xml;image/avif;image/heic;image/heif;
StartupNotify=true
