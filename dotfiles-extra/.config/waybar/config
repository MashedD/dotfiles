{
    "layer": "top",
    "position": "top",
    "modules-left": ["custom/start", "hyprland/workspaces", "wlr/taskbar"],
    "modules-center": ["clock#1", "clock#2", "clock#3"],
    "modules-right": ["pulseaudio", "memory", "cpu", "disk", "battery", "tray"],

    "custom/start": {
        "format": " Start ",
        "on-click": "walker",
        "tooltip": false
    },

    "wlr/taskbar": {
        "format": "{name}",
        "icon-size": 14,
        "icon": true,
        "tooltip": false,
        "all-outputs": false
    },

    "clock#1": {
        "format": "{:%a}",
        "tooltip": false
    },
    "clock#2": {
        "format": "{:%H:%M}",
        "tooltip": false
    },
    "clock#3": {
        "format": "{:%d.%m.%y}",
        "tooltip": false
    },

    "pulseaudio": {
        "format": "{icon} {volume:2}%",
        "format-bluetooth": "{icon}  {volume}%",
        "format-muted": "MUTE",
        "format-icons": {
            "headphones": "",
            "default": [
                "",
                ""
            ]
        },
        "scroll-step": 5,
        "on-click": "pamixer -t",
        "on-click-right": "pavucontrol"
    },
    "memory": {
        "interval": 5,
        "format": "Mem {}%"
    },
    "cpu": {
        "interval": 5,
        "format": "CPU {usage:2}%"
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    },
    "disk": {
        "interval": 5,
        "format": "Disk {percentage_used:2}%",
        "path": "/"
    },
    "tray": {
        "icon-size": 20
    }
}
