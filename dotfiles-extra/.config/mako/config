width=350
height=100
anchor=top-right
#offset=10x50

background-color=#FFFFE1
border-color=#000000
border-size=3
border-radius=0

padding=15
default-timeout=4000
ignore-timeout=0

font="FiraCode Nerd Font 10"
# font="MS Sans Serif 10"
# font="Bitstream Vera Sans 10"
# font="WenQuanYi Micro Hei 10"
# font="DejaVu Sans 10"
# font="Sans 10"

#icons=1
#icon-location=left
# Ścieżka do własnej ikony 48×48 (szary wykrzyknik w kółku)
# Pobierz np. z https://iconarchive.com/show/crystal-clear-icons-by-everaldo/Actions-messagebox-warning-icon.html
# i zapisz jako ~/.icons/win98-warning.png
# icons
format=<b>%s</b>\n%b
# %s = summary (tytuł), %b = body (treść)

text-color=#000000
progress-color=over #000000
group-by=app-name
#grouped=0

layer=overlay

