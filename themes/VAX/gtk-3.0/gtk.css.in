/* Generated by setup-vax-theme. GTK4/libadwaita is intentionally untouched. */
/* Layer the Matrix selection states over Chicago95's GTK3 stylesheet. */
@import url("file://@CHICAGO95_GTK3@");

/* Define these after the import so the Matrix states win over Chicago95 blue. */
@define-color theme_fg_color #000000;
@define-color theme_bg_color #c0c0c0;
@define-color theme_base_color #ffffff;
@define-color theme_text_color #000000;
@define-color selected_bg_color #001a00;
@define-color selected_fg_color #00ff41;

*:selected,
selection,
entry selection,
treeview.view:selected,
row:selected {
  background-color: #001a00;
  color: #00ff41;
}
