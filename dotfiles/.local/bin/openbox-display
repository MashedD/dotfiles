#!/usr/bin/env sh

# Apply the preferred external-monitor layout and watch for hotplug changes.
# The watcher is intentionally polling: xrandr is available on every X11
# session we support and does not require another daemon or D-Bus service.

set -u

igpu_provider='AMD Radeon 660M @ pci:0000:07:00.0'
dgpu_provider='AMD Radeon RX 6500M @ pci:0000:03:00.0'
hdmi_output='HDMI-A-1-0'
internal_output='eDP'
poll_seconds="${OPENBOX_DISPLAY_POLL_SECONDS:-3}"
retry_count="${OPENBOX_DISPLAY_RETRY_COUNT:-3}"
retry_delay="${OPENBOX_DISPLAY_RETRY_DELAY:-1}"
upgrade_delay="${OPENBOX_DISPLAY_UPGRADE_DELAY:-30}"
lock_root="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}"
watcher_lock_file="$lock_root/openbox-display-watcher.lock"
apply_lock_file="$lock_root/openbox-display-apply.lock"

log_message() {
  logger -t openbox-display -- "$*" 2>/dev/null || :
}

usage() {
  printf '%s\n' 'Usage: openbox-display [--once|--watch]' >&2
}

output_connected() {
  output=$1
  xrandr --query | awk -v output="$output" '$1 == output && $2 == "connected" { found=1 } END { exit(found ? 0 : 1) }'
}

display_state() {
  query=$1
  printf '%s\n' "$query" | awk -v hdmi="$hdmi_output" -v internal="$internal_output" '
    $1 == hdmi && $2 == "connected" { h=1 }
    $1 == internal && $2 == "connected" { i=1 }
    END { printf "hdmi-%s:internal-%s\n", (h ? "connected" : "disconnected"), (i ? "connected" : "disconnected") }
  '
}

confirm_enabled() {
  output=$1
  expected=${2:-}
  xrandr --query | awk -v output="$output" -v expected="$expected" '
    $1 == output && $2 == "connected" { in_output=1; next }
    in_output && /^[^[:space:]]/ { exit }
    in_output && /\*/ && (expected == "" || $0 ~ expected) { found=1; exit }
    END { exit(found ? 0 : 1) }
  '
}

disable_output() {
  output=$1
  # Avoid an extra mode change when xrandr reports that the output is not active.
  if output_connected "$output" && xrandr --query | awk -v output="$output" '
      $1 == output && $2 == "connected" { in_output=1; next }
      in_output && /^[^[:space:]]/ { exit }
      in_output && /\*/ { active=1 }
      END { exit(active ? 0 : 1) }
    '; then
    xrandr --output "$output" --off
  else
    return 0
  fi
}

attach_provider() {
  xrandr --setprovideroutputsource "$dgpu_provider" "$igpu_provider" >/dev/null 2>&1 ||
    log_message 'Could not attach the RX 6500M output provider'
}

apply_hdmi() {
  # Leave the internal panel untouched until the external mode is accepted.
  if xrandr --output "$hdmi_output" --primary --mode 2560x1440 --rate 144 --pos 0x0 >/dev/null 2>&1 &&
     confirm_enabled "$hdmi_output" '2560x1440'; then
    disable_output "$internal_output" || return 1
    printf '%s\n' hdmi-exact
    return 0
  fi

  if xrandr --output "$hdmi_output" --primary --auto --pos 0x0 >/dev/null 2>&1 &&
     confirm_enabled "$hdmi_output"; then
    disable_output "$internal_output" || return 1
    printf '%s\n' hdmi-preferred
    return 0
  fi

  return 1
}

apply_internal() {
  # Enable the fallback first and only then turn off HDMI.
  if ! xrandr --output "$internal_output" --primary --auto --pos 0x0 >/dev/null 2>&1 ||
     ! confirm_enabled "$internal_output"; then
    return 1
  fi
  if output_connected "$hdmi_output"; then
    xrandr --output "$hdmi_output" --off >/dev/null 2>&1 ||
      log_message 'Internal display is active; HDMI could not be disabled'
  fi
  printf '%s\n' internal
}

apply_layout_once() {
  state=$1
  case "$state" in
    hdmi-connected:*)
      if apply_hdmi; then
        return 0
      fi
      # HDMI may be electrically connected while its requested mode is unusable.
      apply_internal
      ;;
    *)
      apply_internal
      ;;
  esac
}

apply_layout() {
  state=$1
  exec 8>"$apply_lock_file" || return 1
  flock -w 5 8 || return 1
  attach_provider
  attempt=1
  while [ "$attempt" -le "$retry_count" ]; do
    layout=$(apply_layout_once "$state") && {
      printf '%s\t%s\n' "$state" "$layout"
      return 0
    }
    [ "$attempt" -lt "$retry_count" ] && sleep "$retry_delay"
    attempt=$((attempt + 1))
  done
  return 1
}

read_display_state() (
  # Provider attachment is a display mutation too, so serialize it with mode
  # changes. The subshell releases this descriptor after the observation.
  exec 7>"$apply_lock_file" || return 1
  flock -w 5 7 || return 1
  [ "${1:-}" = attach ] && attach_provider
  query=$(xrandr --query) || return 1
  display_state "$query"
)

run_once() {
  state=$(read_display_state attach) || {
    log_message 'xrandr query failed; display server may be unavailable'
    return 1
  }
  result=$(apply_layout "$state") || {
    log_message "Could not configure display state: $state"
    return 1
  }
  log_message "Applied display layout: $(printf '%s\n' "$result" | awk -F '\t' '{print $2}')"
}

run_watch() {
  exec 9>"$watcher_lock_file" || {
    log_message "Could not open lock file: $watcher_lock_file"
    return 1
  }
  if ! flock -n 9; then
    log_message 'Display watcher already running'
    return 0
  fi

  previous_state=''
  applied_state=''
  applied_layout=''
  failed_state=''
  upgrade_attempts=0
  next_upgrade=0
  first_poll=1
  while :; do
    if [ "$first_poll" -eq 1 ]; then
      state=$(read_display_state attach) || {
        log_message 'xrandr query failed; stopping display watcher'
        return 1
      }
      first_poll=0
    else
      state=$(read_display_state) || {
        log_message 'xrandr query failed; stopping display watcher'
        return 1
      }
    fi
    now=$(date +%s)
    should_apply=0
    should_upgrade=0
    if [ "$state" != "$previous_state" ]; then
      should_apply=1
      log_message "Display connection changed: $state"
      failed_state=''
      upgrade_attempts=0
    elif [ "$state" != "$applied_state" ] && [ "$state" != "$failed_state" ]; then
      should_apply=1
    elif [ "$state" != "$failed_state" ] && [ "$state" = 'hdmi-connected:internal-connected' ] &&
         [ "$applied_layout" != hdmi-exact ] && [ "$upgrade_attempts" -lt 2 ] &&
         [ "$now" -ge "$next_upgrade" ]; then
      # A monitor can advertise its high-refresh mode after hotplug. Upgrade a
      # fallback occasionally, not on every poll.
      should_apply=1
      should_upgrade=1
    fi

    if [ "$should_apply" -eq 1 ]; then
      result=$(apply_layout "$state") || result=''
      if [ -n "$result" ]; then
        layout=$(printf '%s\n' "$result" | awk -F '\t' '{print $2}')
        old_layout=$applied_layout
        applied_state=$state
        applied_layout=$layout
        next_upgrade=$((now + upgrade_delay))
        [ "$should_upgrade" -eq 1 ] && upgrade_attempts=$((upgrade_attempts + 1))
        if [ "$layout" != "$old_layout" ] || [ "$state" != "$previous_state" ]; then
          log_message "Applied display layout: $layout"
        fi
      else
        failed_state=$state
        [ "$should_upgrade" -eq 1 ] && upgrade_attempts=2
        next_upgrade=$((now + upgrade_delay))
        log_message "Could not configure display state after $retry_count attempts: $state"
      fi
    fi
    previous_state=$state
    sleep "$poll_seconds"
  done
}

case "${1:---once}" in
  --once)
    run_once
    ;;
  --watch)
    run_watch
    ;;
  -h|--help)
    usage
    ;;
  *)
    usage
    exit 64
    ;;
esac
