#!/usr/bin/env bash

# BTC/ETH/LTC USD prices for tmux; the Awesome sidebar accepts its own settings.
# Cached and lock-guarded so the 5s status refresh never stacks requests.

set -u

readonly refresh_interval="${CRYPTO_REFRESH_INTERVAL:-60}"
readonly request_timeout="${CRYPTO_TIMEOUT:-5}"
readonly cache_root="${XDG_CACHE_HOME:-${HOME:?HOME must be set}/.cache}/crypto"
cache_file="${CRYPTO_CACHE:-$cache_root/prices.json}"
lock_file="${cache_file}.flock"
api_url='https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum,litecoin&vs_currencies=usd'
sidebar_currency="USD"
sidebar_currency_symbol='$'
sidebar_decimal_separator=','
sidebar_thousands_separator='.'
declare -a sidebar_symbols=(BTC ETH LTC)
declare -a sidebar_ids=(bitcoin ethereum litecoin)
declare -a sidebar_decimals=(0 0 2)

print_unavailable() {
  if [[ "${1:-}" == --sidebar-data ]]; then
    local placeholder="" symbol
    for symbol in "${sidebar_symbols[@]}"; do
      placeholder+="${symbol} -- "
    done
    printf 'crypto-v1\tunavailable\t0\t%s\n' "${placeholder% }"
  else
    printf 'BTC -- ETH -- LTC --\n'
  fi
}

# Insert '.' thousands separators into an integer string (locale-independent).
group_thousands() {
  local value="$1" separator="${2:-.}" grouped="" chunk

  while [[ "$value" =~ ^[0-9]+([0-9]{3})$ ]]; do
    chunk="${BASH_REMATCH[1]}"
    grouped="$separator$chunk$grouped"
    value="${value%$chunk}"
  done
  printf '%s%s' "$value" "$grouped"
}

# price, decimals -> $97.123 (0) or $63,28 (2); dot thousands, comma decimal.
format_usd() {
  local price="$1" decimals="$2" whole frac=""

  [[ "$price" =~ ^[0-9]+(\.[0-9]+)?$ ]] || return 1
  if [[ "$price" == *.* ]]; then
    whole="${price%%.*}"
    frac="${price#*.}"
  else
    whole="$price"
  fi

  if (( decimals == 0 )); then
    printf '$%s' "$(group_thousands "$whole")"
  else
    frac="${frac}00"
    printf '$%s,%s' "$(group_thousands "$whole")" "${frac:0:2}"
  fi
}

load_sidebar_config() {
  local config_path="${XDG_CONFIG_HOME:-${HOME:?HOME must be set}/.config}/desktop-control-center/crypto-prices.json"
  local valid=false ids_csv signature
  if [[ -r "$config_path" ]] && jq -e '
    type == "object" and .version == 1
    and (.currency | type == "string" and test("^[A-Za-z]{3}$"))
    and (.currency_symbol | type == "string" and length >= 1 and length <= 8
      and (.[0:1] | test("^[^0-9]")))
    and (.decimal_separator == "." or .decimal_separator == ",")
    and (.thousands_separator == "." or .thousands_separator == ",")
    and .decimal_separator != .thousands_separator
    and (.tokens | type == "array" and length <= 12
      and all(.[]; (.symbol | type == "string" and test("^[A-Z0-9]{1,10}$"))
        and (.id | type == "string" and test("^[a-z0-9-]{1,64}$"))
        and (.decimals | type == "number" and floor == . and . >= 0 and . <= 8)))
    and ([.tokens[].symbol] | unique | length) == (.tokens | length)
    and ([.tokens[].id] | unique | length) == (.tokens | length)
  ' "$config_path" >/dev/null 2>&1; then
    valid=true
  fi
  if [[ "$valid" == true ]]; then
    sidebar_currency="$(jq -r '.currency | ascii_upcase' "$config_path")"
    sidebar_currency_symbol="$(jq -r '.currency_symbol' "$config_path")"
    sidebar_decimal_separator="$(jq -r '.decimal_separator' "$config_path")"
    sidebar_thousands_separator="$(jq -r '.thousands_separator' "$config_path")"
    mapfile -t sidebar_symbols < <(jq -r '.tokens[].symbol' "$config_path")
    mapfile -t sidebar_ids < <(jq -r '.tokens[].id' "$config_path")
    mapfile -t sidebar_decimals < <(jq -r '.tokens[].decimals' "$config_path")
  elif [[ -r "$config_path" ]]; then
    printf '%s\n' 'crypto-prices: invalid sidebar settings; using BTC/ETH/LTC USD defaults' >&2
  fi
  sidebar_currency="${sidebar_currency^^}"
  local currency_lower="${sidebar_currency,,}"
  ids_csv="$(IFS=,; printf '%s' "${sidebar_ids[*]}")"
  api_url="https://api.coingecko.com/api/v3/simple/price?ids=${ids_csv}&vs_currencies=${currency_lower}"
  signature="$(printf '%s\n' "$sidebar_currency" "$sidebar_currency_symbol" \
      "$sidebar_decimal_separator" "$sidebar_thousands_separator" \
      "${sidebar_symbols[*]}" "${sidebar_ids[*]}" "${sidebar_decimals[*]}" | sha256sum | cut -c1-16)"
  cache_file="${CRYPTO_CACHE:-$cache_root/sidebar-${signature}.json}"
  lock_file="${cache_file}.flock"
}

cache_value() {
  local display fetched_at

  [[ -r "$cache_file" ]] || return 1
  display="$(jq -r '.display // empty' "$cache_file" 2>/dev/null)" || return 1
  fetched_at="$(jq -r '.fetched_at // 0' "$cache_file" 2>/dev/null)" || return 1
  [[ -n "$display" && "$fetched_at" =~ ^[0-9]+$ && "$fetched_at" -gt 0 ]] || return 1

  printf '%s\t%s\n' "$display" "$fetched_at"
}

write_cache() {
  local display="$1"
  local fetched_at="$2"
  local temporary_file

  mkdir -p "$(dirname -- "$cache_file")" 2>/dev/null || return 1
  temporary_file="${cache_file}.$$"
  umask 077
  printf '{"display":%s,"fetched_at":%s}\n' \
    "$(jq -Rn --arg value "$display" '$value')" "$fetched_at" >"$temporary_file" || {
    rm -f "$temporary_file"
    return 1
  }
  mv -f "$temporary_file" "$cache_file"
}

fetch_result() {
  curl -fsS --max-time "$request_timeout" "$api_url" 9>&- 2>/dev/null || return 1
}

format_sidebar_price() {
  local price="$1" decimals="$2" fixed whole fraction=""
  [[ "$price" =~ ^[0-9]+([.][0-9]+)?([eE][+-]?[0-9]+)?$ ]] || return 1
  fixed="$(LC_ALL=C awk -v value="$price" -v digits="$decimals" \
    'BEGIN { scale = 10 ^ digits; value = int(value * scale) / scale; printf "%.*f", digits, value }')" || return 1
  whole="${fixed%%.*}"
  if (( decimals > 0 )); then fraction="${fixed#*.}"; fi
  whole="$(group_thousands "$whole" "$sidebar_thousands_separator")"
  if (( decimals > 0 )); then
    printf '%s%s%s' "$whole" "$sidebar_decimal_separator" "$fraction"
  else
    printf '%s' "$whole"
  fi
}

format_sidebar_result() {
  local result="$1" display="" index id symbol decimals price formatted
  for index in "${!sidebar_ids[@]}"; do
    id="${sidebar_ids[$index]}"
    symbol="${sidebar_symbols[$index]}"
    decimals="${sidebar_decimals[$index]}"
    price="$(jq -r --arg id "$id" --arg currency "${sidebar_currency,,}" \
      '.[$id][$currency] // empty' <<<"$result" 2>/dev/null)" || return 1
    [[ -n "$price" ]] || return 1
    formatted="$(format_sidebar_price "$price" "$decimals")" || return 1
    display+="#[fg=#006400]${symbol} #[fg=#55ff99,bold]${sidebar_currency_symbol}${formatted} "
  done
  printf '%s' "${display% }"
}

format_result() {
  local result="$1"
  local btc eth ltc

  btc="$(jq -r '.bitcoin.usd // empty' <<<"$result" 2>/dev/null)" || return 1
  eth="$(jq -r '.ethereum.usd // empty' <<<"$result" 2>/dev/null)" || return 1
  ltc="$(jq -r '.litecoin.usd // empty' <<<"$result" 2>/dev/null)" || return 1
  [[ -n "$btc" && -n "$eth" && -n "$ltc" ]] || return 1

  local btc_display eth_display ltc_display
  btc_display="$(format_usd "$btc" 0)" || return 1
  eth_display="$(format_usd "$eth" 0)" || return 1
  ltc_display="$(format_usd "$ltc" 2)" || return 1
  printf '#[fg=#006400]BTC #[fg=#55ff99,bold]%s #[fg=#006400]ETH #[fg=#55ff99,bold]%s #[fg=#006400]LTC #[fg=#55ff99,bold]%s' \
    "$btc_display" "$eth_display" "$ltc_display"
}

main() {
  local mode="${1:-tmux}" now cached cached_display cached_at age result display
  if [[ "$mode" == --sidebar-data ]]; then
    load_sidebar_config
  else
    cache_file="${CRYPTO_CACHE:-$cache_root/prices.json}"
    lock_file="${cache_file}.flock"
  fi
  now="$(date +%s)"
  emit() {
    local value="$1" at="${2:-0}" status="${3:-unavailable}"
    if [[ "$mode" == --sidebar-data ]]; then
      printf 'crypto-v1\t%s\t%s\t%s\n' "$status" "$at" "$value"
    elif [[ "$status" == stale ]]; then
      printf 'STALE %s\n' "$value"
    else
      printf '%s\n' "$value"
    fi
  }

  if [[ "$mode" == --sidebar-data && ${#sidebar_ids[@]} -eq 0 ]]; then
    emit "" "$now" fresh
    return 0
  fi

  cached="$(cache_value 2>/dev/null || true)"
  cached_display="${cached%%$'\t'*}"
  cached_at="${cached#*$'\t'}"
  [[ "$cached" == *$'\t'* ]] || cached_at=0
  [[ "$cached_at" =~ ^[0-9]+$ ]] || cached_at=0
  age=$((now - cached_at))

  if (( cached_at > 0 && age >= 0 && age < refresh_interval )); then
    emit "$cached_display" "$cached_at" fresh
    return 0
  fi

  mkdir -p "$(dirname -- "$cache_file")" 2>/dev/null || true
  umask 077
  if ! { exec 9>"$lock_file"; } 2>/dev/null || ! flock -n 9; then
    if (( cached_at > 0 )); then
      emit "$cached_display" "$cached_at" stale
    else
      print_unavailable "$mode"
    fi
    return 0
  fi

  result="$(fetch_result 2>/dev/null || true)"
  if [[ "$mode" == --sidebar-data ]]; then
    display="$(format_sidebar_result "$result" 2>/dev/null)"
  else
    display="$(format_result "$result" 2>/dev/null)"
  fi
  if [[ -n "$result" && ( -n "$display" || ( "$mode" == --sidebar-data && ${#sidebar_ids[@]} -eq 0 ) ) ]]; then
    now="$(date +%s)"
    write_cache "$display" "$now" 2>/dev/null || true
    emit "$display" "$now" fresh
  elif (( cached_at > 0 )); then
    emit "$cached_display" "$cached_at" stale
  else
    print_unavailable "$mode"
  fi
}

if ! command -v curl >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1 \
    || ! command -v flock >/dev/null 2>&1 || ! command -v awk >/dev/null 2>&1; then
  print_unavailable "${1:-}"
  exit 0
fi

main "$@"
