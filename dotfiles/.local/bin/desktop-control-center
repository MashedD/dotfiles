#!/usr/bin/env python3
"""A small GTK control center for the Awesome X11 desktop."""
from __future__ import annotations

import os
from pathlib import Path
import shutil
import subprocess
import sys
import threading

# This package is Stow-linked into the repository; keep runtime bytecode out of it.
sys.dont_write_bytecode = True

try:
    import gi
    gi.require_version("Gdk", "3.0")
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gdk, GLib, Gtk
except (ImportError, ValueError) as exc:  # pragma: no cover - depends on system packages
    print(f"desktop-control-center: GTK 3 / PyGObject is required: {exc}", file=sys.stderr)
    raise SystemExit(1)

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
import desktop_news_config  # noqa: E402
from desktop_control_center.settings import (  # noqa: E402
    SIDEBAR_SECTIONS,
    TOOLBAR_STYLES,
    apply_settings,
    atomic_write,
    parse_sidebar_enabled,
    settings_from_files,
    update_sidebar_enabled_text,
)

HOME = Path.home()
CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
DATA_HOME = Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share"))
STATE_HOME = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state"))
XSETTINGS_PATH = CONFIG_HOME / "xsettingsd/xsettingsd.conf"
GTK_SETTINGS_PATH = CONFIG_HOME / "gtk-3.0/settings.ini"
SIDEBAR_SECTIONS_PATH = STATE_HOME / "awesome/sidebar-sections"
NEWS_CONFIG_PATH = desktop_news_config.config_path()
NEWS_HELPER = HOME / ".local/bin/desktop-news"


def _data_dirs() -> list[Path]:
    result = [DATA_HOME, *(Path(part) for part in os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":"))]
    result.extend((HOME / ".icons", HOME / ".themes"))
    unique: list[Path] = []
    seen: set[str] = set()
    for path in result:
        key = str(path.expanduser())
        if key not in seen:
            unique.append(path.expanduser())
            seen.add(key)
    return unique


def _theme_names(kind: str) -> list[str]:
    found: set[str] = set()
    for base in _data_dirs():
        roots = [base / "themes"] if base.name != ".themes" else [base]
        if kind in {"icons", "cursors"}:
            roots += [base / "icons"] if base.name != ".icons" else [base]
        for root in roots:
            try:
                children = list(root.iterdir())
            except (FileNotFoundError, PermissionError, NotADirectoryError):
                continue
            for child in children:
                if not child.is_dir():
                    continue
                if kind == "gtk" and not any((child / version).is_dir() for version in ("gtk-3.0", "gtk-2.0")):
                    continue
                if kind == "icons" and not (child / "index.theme").is_file():
                    continue
                if kind == "cursors" and not (child / "cursors").is_dir():
                    continue
                found.add(child.name)
    return sorted(found, key=str.casefold)


def _color_from_scheme(scheme: str, name: str, fallback: str) -> str:
    for entry in scheme.splitlines():
        key, separator, value = entry.partition(":")
        if separator and key.strip() == name and value.strip().startswith("#"):
            color = value.strip()
            if len(color) in (7, 9):
                return color[:7]
    return fallback


def _hex_color(rgba: Gdk.RGBA) -> str:
    return "#{:02x}{:02x}{:02x}".format(
        round(max(0.0, min(1.0, rgba.red)) * 255),
        round(max(0.0, min(1.0, rgba.green)) * 255),
        round(max(0.0, min(1.0, rgba.blue)) * 255),
    )


def _read_initial_settings() -> dict[str, object]:
    xsettings = XSETTINGS_PATH.read_text(encoding="utf-8") if XSETTINGS_PATH.exists() else ""
    gtk_settings = GTK_SETTINGS_PATH.read_text(encoding="utf-8") if GTK_SETTINGS_PATH.exists() else ""
    try:
        return settings_from_files(xsettings, gtk_settings)
    except Exception as exc:
        raise RuntimeError(f"Could not read the appearance settings: {exc}") from exc


class ControlCenter(Gtk.Window):
    def __init__(self) -> None:
        super().__init__(title="Desktop Control Center")
        self.set_default_size(760, 800)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_icon_name("preferences-system")
        self.connect("destroy", lambda *_: Gtk.main_quit())
        self.settings = _read_initial_settings()
        self.widgets: dict[str, object] = {}
        self.sidebar_widgets: dict[str, Gtk.CheckButton] = {}
        self.news_category_rows: list[dict[str, object]] = []
        self.news_feed_rows: list[dict[str, object]] = []
        self.news_config: dict[str, object] = {}
        self.tool_buttons: dict[str, Gtk.Button] = {}

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(outer)
        self.notebook = Gtk.Notebook()
        self.notebook.set_border_width(12)
        outer.pack_start(self.notebook, True, True, 0)
        self._build_tools_page()
        self._build_appearance_page()
        self._build_sidebar_page()
        self._build_news_page()

        actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        actions.set_border_width(12)
        self.status = Gtk.Label(label="Choose a tool or select a settings tab.")
        self.status.set_xalign(0)
        self.status.set_line_wrap(True)
        actions.pack_start(self.status, True, True, 0)
        self.revert_button = Gtk.Button.new_with_mnemonic("_Revert")
        self.revert_button.connect("clicked", self._revert)
        actions.pack_start(self.revert_button, False, False, 0)
        self.apply_button = Gtk.Button.new_with_mnemonic("_Apply")
        self.apply_button.get_style_context().add_class("suggested-action")
        self.apply_button.connect("clicked", self._apply)
        actions.pack_start(self.apply_button, False, False, 0)
        close = Gtk.Button.new_with_mnemonic("_Close")
        close.connect("clicked", lambda *_: self.destroy())
        actions.pack_start(close, False, False, 0)
        outer.pack_end(actions, False, False, 0)
        self.notebook.connect("switch-page", self._update_action_buttons)
        self._update_action_buttons(self.notebook, None, self.notebook.get_current_page())

    def _add_tab(self, title: str) -> tuple[Gtk.Grid, Gtk.ScrolledWindow]:
        grid = Gtk.Grid(column_spacing=16, row_spacing=9, margin=12)
        grid.set_column_homogeneous(False)
        page = Gtk.ScrolledWindow()
        page.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        page.add(grid)
        self.notebook.append_page(page, Gtk.Label(label=title))
        return grid, page

    def _row(self, grid: Gtk.Grid, row: int, label: str, widget: Gtk.Widget, key: str) -> None:
        text = Gtk.Label(label=label)
        text.set_xalign(0)
        text.set_valign(Gtk.Align.CENTER)
        grid.attach(text, 0, row, 1, 1)
        widget.set_hexpand(True)
        widget.set_halign(Gtk.Align.FILL)
        grid.attach(widget, 1, row, 1, 1)
        self.widgets[key] = widget

    def _combo(self, options: list[tuple[str, str]], current: str) -> Gtk.ComboBoxText:
        combo = Gtk.ComboBoxText()
        seen: set[str] = set()
        for value, label in options:
            if value not in seen:
                combo.append(value, label)
                seen.add(value)
        if current not in seen:
            combo.append(current, f"{current} (current)")
        combo.set_active_id(current)
        return combo

    def _check(self, label: str, key: str) -> Gtk.CheckButton:
        button = Gtk.CheckButton.new_with_label(label)
        button.set_active(bool(int(self.settings[key])))
        self.widgets[key] = button
        return button

    def _build_appearance_page(self) -> None:
        grid, _ = self._add_tab("Appearance")
        values = self.settings
        row = 0
        theme = self._combo([(name, name) for name in _theme_names("gtk")], str(values["Net/ThemeName"]))
        self._row(grid, row, "GTK theme", theme, "Net/ThemeName"); row += 1
        icons = self._combo([(name, name) for name in _theme_names("icons")], str(values["Net/IconThemeName"]))
        self._row(grid, row, "Icon theme", icons, "Net/IconThemeName"); row += 1
        cursors = self._combo([(name, name) for name in _theme_names("cursors")], str(values["Gtk/CursorThemeName"]))
        self._row(grid, row, "Cursor theme", cursors, "Gtk/CursorThemeName"); row += 1

        font = Gtk.FontButton()
        font.set_title("Choose interface font")
        font.set_show_size(True)
        font.set_use_font(True)
        font.set_font_name(str(values["Gtk/FontName"]))
        self._row(grid, row, "Interface font", font, "Gtk/FontName"); row += 1

        cursor_size = Gtk.SpinButton.new_with_range(0, 128, 1)
        cursor_size.set_value(int(values["Gtk/CursorThemeSize"]))
        cursor_size.set_numeric(True)
        cursor_size.set_tooltip_text("0 uses the cursor theme's default size")
        self._row(grid, row, "Cursor size (0 = theme default)", cursor_size, "Gtk/CursorThemeSize"); row += 1

        toolbar_options = [(str(number), label.replace("GTK_TOOLBAR_", "").replace("_", " ").title())
                           for number, label in TOOLBAR_STYLES.items()]
        toolbar = self._combo(toolbar_options, str(values["Gtk/ToolbarStyle"]))
        self._row(grid, row, "Toolbar style", toolbar, "Gtk/ToolbarStyle"); row += 1

        scheme = str(values["Gtk/ColorScheme"])
        bg_button = self._color_button(_color_from_scheme(scheme, "selected_bg_color", "#3584e4"))
        fg_button = self._color_button(_color_from_scheme(scheme, "selected_fg_color", "#ffffff"))
        colors = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        colors.pack_start(Gtk.Label(label="Selection"), False, False, 0)
        colors.pack_start(bg_button, False, False, 0)
        colors.pack_start(Gtk.Label(label="Text"), False, False, 0)
        colors.pack_start(fg_button, False, False, 0)
        self.widgets["selection-bg"] = bg_button
        self.widgets["selection-fg"] = fg_button
        self._row(grid, row, "Selection colors", colors, "Gtk/ColorScheme"); row += 1

        behavior = Gtk.Frame(label="GTK behavior")
        behavior_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        behavior_box.set_border_width(8)
        for key, label in (
            ("Gtk/ButtonImages", "Show images on buttons"),
            ("Gtk/MenuImages", "Show images in menus"),
            ("Gtk/EnableAnimations", "Enable interface animations"),
            ("Gtk/EnableEventSounds", "Enable event sounds"),
            ("Gtk/EnableInputFeedbackSounds", "Enable input feedback sounds"),
        ):
            behavior_box.pack_start(self._check(label, key), False, False, 0)
        behavior.add(behavior_box)
        grid.attach(behavior, 0, row, 2, 1); row += 1

        font_frame = Gtk.Frame(label="Font rendering")
        font_grid = Gtk.Grid(column_spacing=14, row_spacing=7, margin=8)
        font_frame.add(font_grid)
        font_grid.attach(self._check("Antialias fonts", "Xft/Antialias"), 0, 0, 1, 1)
        font_grid.attach(self._check("Hint font outlines", "Xft/Hinting"), 1, 0, 1, 1)
        hint_style = self._combo([(name, label) for name, label in (
            ("hintnone", "None"), ("hintslight", "Slight"), ("hintmedium", "Medium"), ("hintfull", "Full"),
        )], str(values["Xft/HintStyle"]))
        self._row(font_grid, 1, "Hint style", hint_style, "Xft/HintStyle")
        subpixel = self._combo([(name, label) for name, label in (
            ("none", "None"), ("rgb", "RGB"), ("bgr", "BGR"), ("vrgb", "Vertical RGB"), ("vbgr", "Vertical BGR"),
        )], str(values["Xft/RGBA"]))
        self._row(font_grid, 2, "Subpixel order", subpixel, "Xft/RGBA")
        grid.attach(font_frame, 0, row, 2, 1)

        note = Gtk.Label(label="Apply saves these choices and restarts xsettingsd. Some already-open applications may need restarting.")
        note.set_xalign(0)
        note.set_line_wrap(True)
        grid.attach(note, 0, row + 1, 2, 1)

    @staticmethod
    def _color_button(value: str) -> Gtk.ColorButton:
        rgba = Gdk.RGBA()
        if not rgba.parse(value):
            rgba.parse("#3584e4")
        button = Gtk.ColorButton.new_with_rgba(rgba)
        button.set_use_alpha(False)
        return button

    def _build_tools_page(self) -> None:
        grid, _ = self._add_tab("Devices & Tools")
        tools = (
            ("Display outputs", "display-profiles", "video-display",
             "Choose internal, HDMI, extended, or automatic layout"),
            ("Arrange displays (ArandR)", "arandr", "video-display",
             "Fine-tune monitor positions and resolutions"),
            ("System monitor", "btop", "utilities-system-monitor", "Open btop in Kitty"),
            ("htop", "htop", "utilities-system-monitor", "Lightweight process viewer in Kitty"),
            ("AMDGPU TOP", "amdgpu_top", "video-display", "GPU utilization and performance"),
            ("Task Manager", "xfce4-taskmanager", "utilities-system-monitor", "Manage and stop desktop applications"),
            ("Sound", "pavucontrol", "audio-volume-high", "Manage audio devices and applications"),
            ("Network", "nm-connection-editor", "network-wired", "Manage NetworkManager connections"),
            ("Bluetooth Manager", "blueman-manager", "preferences-system-bluetooth",
             "Pair and manage Bluetooth devices"),
            ("Power Manager", "xfce4-power-manager-settings", "preferences-system-power-management",
             "Configure laptop power and battery behavior"),
            ("Logitech devices", "solaar", "input-mouse",
             "Inspect and configure Logitech devices (manual launch only)"),
        )
        for index, (label, action, icon, description) in enumerate(tools):
            row, column = divmod(index, 2)
            button = Gtk.Button()
            contents = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            contents.set_border_width(10)
            image = Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.DIALOG)
            contents.pack_start(image, False, False, 0)
            text_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            title = Gtk.Label(label=label)
            title.set_xalign(0)
            title.get_style_context().add_class("heading")
            detail = Gtk.Label(label=description)
            detail.set_xalign(0)
            detail.set_line_wrap(True)
            text_box.pack_start(title, False, False, 0)
            text_box.pack_start(detail, False, False, 0)
            contents.pack_start(text_box, True, True, 0)
            button.add(contents)
            self.tool_buttons[action] = button

            if action == "display-profiles":
                executable = shutil.which("desktop-display")
                if executable:
                    button.connect("clicked", self._show_display_profiles, executable)
                else:
                    button.set_sensitive(False)
                    button.set_tooltip_text("desktop-display is not installed")
            elif action in {"btop", "htop"}:
                kitty, monitor = shutil.which("kitty"), shutil.which(action)
                if kitty and monitor:
                    title = "System Monitor" if action == "btop" else "Process Viewer"
                    button.connect("clicked", self._launch_argv,
                                   [kitty, "--title", title, monitor])
                else:
                    button.set_sensitive(False)
                    button.set_tooltip_text(f"Kitty and {action} are required")
            elif action == "amdgpu_top":
                executable = shutil.which(action)
                if executable:
                    button.connect("clicked", self._launch_argv, [executable, "--gui"])
                else:
                    button.set_sensitive(False)
                    button.set_tooltip_text("amdgpu_top is not installed")
            else:
                executable = shutil.which(action)
                if executable:
                    button.connect("clicked", self._launch_tool, executable)
                else:
                    button.set_sensitive(False)
                    button.set_tooltip_text(f"{action} is not installed")
            grid.attach(button, column, row, 1, 1)
        note = Gtk.Label(label="Display profiles use the same desktop-display helper as Awesome. Device and power tools launch only when selected; Solaar is never started automatically.")
        note.set_xalign(0)
        note.set_line_wrap(True)
        grid.attach(note, 0, (len(tools) + 1) // 2, 2, 1)

    def _build_sidebar_page(self) -> None:
        grid, _ = self._add_tab("Sidebar")
        intro = Gtk.Label(label="Choose which sections appear in the Awesome sidebar.")
        intro.set_xalign(0)
        intro.set_line_wrap(True)
        grid.attach(intro, 0, 0, 2, 1)

        frame = Gtk.Frame(label="Visible sections")
        options = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        options.set_border_width(10)
        try:
            text = SIDEBAR_SECTIONS_PATH.read_text(encoding="utf-8") if SIDEBAR_SECTIONS_PATH.exists() else ""
            enabled = parse_sidebar_enabled(text)
        except OSError as exc:
            raise RuntimeError(f"Could not read sidebar settings: {exc}") from exc
        for section_id, label in SIDEBAR_SECTIONS:
            checkbox = Gtk.CheckButton.new_with_label(label)
            checkbox.set_active(section_id in enabled)
            self.sidebar_widgets[section_id] = checkbox
            options.pack_start(checkbox, False, False, 0)
        frame.add(options)
        grid.attach(frame, 0, 1, 2, 1)

        self.sidebar_restart_button = Gtk.Button.new_with_label("Save & Restart Awesome")
        self.sidebar_restart_button.get_style_context().add_class("suggested-action")
        self.sidebar_restart_button.set_tooltip_text(
            "Save these choices and restart Awesome now (also available with Win+Ctrl+R)."
        )
        if shutil.which("awesome-client"):
            self.sidebar_restart_button.connect("clicked", self._save_and_restart_awesome)
        else:
            self.sidebar_restart_button.set_sensitive(False)
            self.sidebar_restart_button.set_tooltip_text("awesome-client is not installed")
        grid.attach(self.sidebar_restart_button, 0, 2, 2, 1)

        note = Gtk.Label(label=(
            "Quick Launch starts hidden to save space. Trash is shown in System Status. "
            "Use Save Sidebar to apply later, or save and restart now."
        ))
        note.set_xalign(0)
        note.set_line_wrap(True)
        grid.attach(note, 0, 3, 2, 1)

    def _build_news_page(self) -> None:
        grid, _ = self._add_tab("News")
        intro = Gtk.Label(label=(
            "Manage RSS/Atom categories and sources. New profiles start empty; existing News settings "
            "are migrated once. Changes take effect after a News refresh or an explicit Awesome restart."
        ))
        intro.set_xalign(0)
        intro.set_line_wrap(True)
        grid.attach(intro, 0, 0, 2, 1)

        category_frame = Gtk.Frame(label="Categories")
        category_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        category_box.set_border_width(8)
        self.news_category_list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        category_box.pack_start(self.news_category_list, False, False, 0)
        add_category = Gtk.Button.new_with_label("Add Category")
        add_category.connect("clicked", self._add_news_category)
        category_box.pack_start(add_category, False, False, 0)
        category_frame.add(category_box)
        grid.attach(category_frame, 0, 1, 2, 1)

        feed_frame = Gtk.Frame(label="Feed sources")
        feed_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        feed_box.set_border_width(8)
        self.news_feed_list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        feed_box.pack_start(self.news_feed_list, False, False, 0)
        self.news_add_feed_button = Gtk.Button.new_with_label("Add Feed")
        self.news_add_feed_button.connect("clicked", self._add_news_feed)
        feed_box.pack_start(self.news_add_feed_button, False, False, 0)
        feed_frame.add(feed_box)
        grid.attach(feed_frame, 0, 2, 2, 1)

        self.news_restart_button = Gtk.Button.new_with_label("Save & Restart Awesome")
        self.news_restart_button.get_style_context().add_class("suggested-action")
        self.news_restart_button.set_tooltip_text(
            "Save News settings and explicitly restart Awesome now (also available with Win+Ctrl+R)."
        )
        if shutil.which("awesome-client"):
            self.news_restart_button.connect("clicked", self._save_news_and_restart)
        else:
            self.news_restart_button.set_sensitive(False)
            self.news_restart_button.set_tooltip_text("awesome-client is not installed")
        grid.attach(self.news_restart_button, 0, 3, 2, 1)

        note = Gtk.Label(label=(
            "Feed tests make one bounded public HTTP(S) request and do not add stories. "
            "Multiple feeds can share a category; removing a category never clears inbox history."
        ))
        note.set_xalign(0)
        note.set_line_wrap(True)
        grid.attach(note, 0, 4, 2, 1)
        self._reload_news_config_data()

    def _news_category_ids(self) -> set[str]:
        return {str(row["id"]) for row in self.news_category_rows}

    def _add_news_category(self, *_args: object, category_id: str | None = None,
                           label: str | None = None) -> None:
        if category_id is None and len(self.news_category_rows) >= desktop_news_config.MAX_CATEGORIES:
            self.status.set_text(f"At most {desktop_news_config.MAX_CATEGORIES} categories are supported.")
            return
        name = label or f"Category {len(self.news_category_rows) + 1}"
        category_id = category_id or desktop_news_config.new_category_id(name, self._news_category_ids())
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        entry = Gtk.Entry()
        entry.set_placeholder_text("Category name")
        entry.set_text(name)
        entry.set_tooltip_text("Names are customizable; the category ID remains stable when renamed.")
        remove = Gtk.Button.new_with_label("Remove")
        record = {"id": category_id, "entry": entry, "widget": row}
        remove.connect("clicked", self._remove_news_category, record)
        entry.connect("changed", self._refresh_news_category_combos)
        row.pack_start(entry, True, True, 0)
        row.pack_start(remove, False, False, 0)
        self.news_category_rows.append(record)
        self.news_category_list.pack_start(row, False, False, 0)
        row.show_all()
        self._refresh_news_category_combos()

    def _remove_news_category(self, _button: Gtk.Button, record: dict[str, object]) -> None:
        category_id = str(record["id"])
        if any(row["category"].get_active_id() == category_id for row in self.news_feed_rows):
            self.status.set_text("Reassign or remove this category’s feeds before deleting it.")
            return
        self.news_category_rows.remove(record)
        record["widget"].destroy()
        self._refresh_news_category_combos()

    def _refresh_news_category_combos(self, *_args: object) -> None:
        categories = [(str(row["id"]), row["entry"].get_text().strip())
                      for row in self.news_category_rows]
        for feed in self.news_feed_rows:
            combo = feed["category"]
            selected = combo.get_active_id()
            combo.remove_all()
            for category_id, label in categories:
                combo.append(category_id, label or "(unnamed category)")
            if selected and any(category_id == selected for category_id, _ in categories):
                combo.set_active_id(selected)
            elif categories:
                combo.set_active_id(categories[0][0])
            combo.set_sensitive(bool(categories))
        self.news_add_feed_button.set_sensitive(bool(categories))

    def _add_news_feed(self, *_args: object, feed: dict | None = None) -> None:
        if feed is None and len(self.news_feed_rows) >= desktop_news_config.MAX_FEEDS:
            self.status.set_text(f"At most {desktop_news_config.MAX_FEEDS} feeds are supported.")
            return
        feed = feed or {"id": desktop_news_config.new_feed_id(), "category": "",
                        "label": "", "url": "", "enabled": True}
        container = Gtk.Frame()
        source_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
        source_box.set_border_width(7)
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        enabled = Gtk.CheckButton.new_with_label("Enabled")
        enabled.set_active(bool(feed.get("enabled", True)))
        label = Gtk.Entry()
        label.set_placeholder_text("Source name")
        label.set_text(str(feed.get("label", "")))
        category = Gtk.ComboBoxText()
        category.set_size_request(130, -1)
        test = Gtk.Button.new_with_label("Test")
        remove = Gtk.Button.new_with_label("Remove")
        url = Gtk.Entry()
        url.set_placeholder_text("https://example.org/feed.xml")
        url.set_text(str(feed.get("url", "")))
        test.set_tooltip_text("Fetch and parse this URL once without changing the inbox.")
        test.connect("clicked", self._test_news_feed, url)
        record = {"id": str(feed.get("id") or desktop_news_config.new_feed_id()),
                  "enabled": enabled, "label": label, "category": category, "url": url,
                  "widget": container}
        remove.connect("clicked", self._remove_news_feed, record)
        row.pack_start(enabled, False, False, 0)
        row.pack_start(label, True, True, 0)
        row.pack_start(category, False, False, 0)
        row.pack_start(test, False, False, 0)
        row.pack_start(remove, False, False, 0)
        source_box.pack_start(row, False, False, 0)
        source_box.pack_start(url, False, False, 0)
        container.add(source_box)
        self.news_feed_rows.append(record)
        self.news_feed_list.pack_start(container, False, False, 0)
        self._refresh_news_category_combos()
        if feed.get("category"):
            category.set_active_id(str(feed["category"]))
        container.show_all()

    def _remove_news_feed(self, _button: Gtk.Button, record: dict[str, object]) -> None:
        self.news_feed_rows.remove(record)
        record["widget"].destroy()

    def _test_news_feed(self, button: Gtk.Button, url_entry: Gtk.Entry) -> None:
        url = url_entry.get_text().strip()
        normalized = desktop_news_config.valid_http_url(url)
        if not normalized:
            self.status.set_text("Enter a valid HTTP(S) feed URL without credentials first.")
            return
        executable = NEWS_HELPER if NEWS_HELPER.is_file() else Path(shutil.which("desktop-news") or "")
        if not executable.is_file():
            self.status.set_text("desktop-news is not installed.")
            return
        button.set_sensitive(False)
        button.set_label("Testing…")

        def worker() -> None:
            try:
                result = subprocess.run([str(executable), "test-feed", normalized],
                                        stdin=subprocess.DEVNULL, capture_output=True,
                                        text=True, timeout=12, check=False)
                message = (result.stdout if result.returncode == 0 else result.stderr).strip()
                success = result.returncode == 0
            except (OSError, subprocess.TimeoutExpired) as exc:
                message, success = str(exc), False
            GLib.idle_add(self._finish_news_feed_test, button, success, message)

        threading.Thread(target=worker, daemon=True).start()

    def _finish_news_feed_test(self, button: Gtk.Button, success: bool, message: str) -> bool:
        button.set_label("Test")
        button.set_sensitive(True)
        self.status.set_text(message or ("Feed test succeeded." if success else "Feed test failed."))
        return False

    def _collect_news_config(self) -> dict:
        categories = [{"id": str(row["id"]), "label": row["entry"].get_text().strip()}
                      for row in self.news_category_rows]
        feeds = []
        for row in self.news_feed_rows:
            feeds.append({"id": str(row["id"]), "category": row["category"].get_active_id(),
                          "label": row["label"].get_text().strip(), "url": row["url"].get_text().strip(),
                          "enabled": row["enabled"].get_active()})
        return {"version": desktop_news_config.CONFIG_VERSION,
                "categories": categories, "feeds": feeds}

    def _save_news_settings(self) -> bool:
        try:
            self.news_config = desktop_news_config.save_config(
                self._collect_news_config(), NEWS_CONFIG_PATH)
        except Exception as exc:
            self.status.set_text(f"Could not save News settings: {exc}")
            return False
        self.status.set_text("News settings saved. They take effect on the next feed refresh or Awesome restart.")
        return True

    def _reload_news_config_data(self) -> None:
        self.news_config = desktop_news_config.load_config(NEWS_CONFIG_PATH)
        for row in self.news_category_rows:
            row["widget"].destroy()
        for row in self.news_feed_rows:
            row["widget"].destroy()
        self.news_category_rows.clear()
        self.news_feed_rows.clear()
        for category in self.news_config["categories"]:
            self._add_news_category(category_id=category["id"], label=category["label"])
        for feed in self.news_config["feeds"]:
            self._add_news_feed(feed=feed)
        self._refresh_news_category_combos()

    def _reload_news_settings(self) -> None:
        try:
            self._reload_news_config_data()
            self.status.set_text("News settings reloaded from disk.")
        except Exception as exc:
            self.status.set_text(f"Could not reload News settings: {exc}")

    def _save_news_and_restart(self, *_args: object) -> None:
        if self._save_news_settings():
            self._request_awesome_restart("News settings saved; Awesome restart requested.")

    def _request_awesome_restart(self, success_message: str) -> None:
        executable = shutil.which("awesome-client")
        if not executable:
            self.status.set_text("Settings saved, but awesome-client is not installed.")
            return
        try:
            subprocess.Popen(
                [executable, "awesome.restart()"], stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        except OSError as exc:
            self.status.set_text(f"Settings saved, but Awesome could not be restarted: {exc}")
            return
        self.status.set_text(success_message)

    def _update_action_buttons(self, _notebook: Gtk.Notebook, _page: Gtk.Widget | None,
                               page_number: int) -> None:
        if page_number == 3:
            self.revert_button.set_label("_Reload")
            self.apply_button.set_label("_Save News")
            self.revert_button.set_sensitive(True)
            self.apply_button.set_sensitive(True)
            self.status.set_text("Edit custom categories and RSS/Atom sources. Feed tests do not save inbox items.")
        elif page_number == 2:
            self.revert_button.set_label("_Reload")
            self.apply_button.set_label("_Save Sidebar")
            self.revert_button.set_sensitive(True)
            self.apply_button.set_sensitive(True)
            self.status.set_text("Save sidebar visibility here; restart Awesome with the button or Win+Ctrl+R.")
        elif page_number == 1:
            self.revert_button.set_label("_Revert")
            self.apply_button.set_label("_Apply")
            self.revert_button.set_sensitive(True)
            self.apply_button.set_sensitive(True)
            self.status.set_text("Appearance settings are saved to xsettingsd.conf and GTK settings.ini.")
        else:
            self.revert_button.set_sensitive(False)
            self.apply_button.set_sensitive(False)
            self.status.set_text("Choose a tool or select a settings tab.")

    def _save_sidebar_settings(self) -> bool:
        enabled = {section_id for section_id, checkbox in self.sidebar_widgets.items()
                   if checkbox.get_active()}
        try:
            previous = (SIDEBAR_SECTIONS_PATH.read_text(encoding="utf-8")
                        if SIDEBAR_SECTIONS_PATH.exists() else "")
            updated = update_sidebar_enabled_text(previous, enabled)
            atomic_write(SIDEBAR_SECTIONS_PATH, updated)
        except Exception as exc:
            self.status.set_text(f"Could not save sidebar settings: {exc}")
            return False
        self.status.set_text("Sidebar visibility saved. Restart Awesome to apply it.")
        return True

    def _save_and_restart_awesome(self, *_args: object) -> None:
        if self._save_sidebar_settings():
            self._request_awesome_restart("Sidebar saved; Awesome restart requested.")

    def _reload_sidebar_settings(self) -> None:
        try:
            text = (SIDEBAR_SECTIONS_PATH.read_text(encoding="utf-8")
                    if SIDEBAR_SECTIONS_PATH.exists() else "")
            enabled = parse_sidebar_enabled(text)
            for section_id, checkbox in self.sidebar_widgets.items():
                checkbox.set_active(section_id in enabled)
            self.status.set_text("Sidebar choices reloaded from saved settings.")
        except OSError as exc:
            self.status.set_text(f"Could not reload sidebar settings: {exc}")

    def _show_display_profiles(self, button: Gtk.Button, executable: str) -> None:
        menu = Gtk.Menu()
        for label, option in (
            ("Internal display only", "--internal"),
            ("External HDMI only", "--hdmi"),
            ("Extend desktop (laptop + HDMI)", "--extend"),
            ("Restore automatic layout", "--once"),
        ):
            item = Gtk.MenuItem.new_with_label(label)
            item.connect("activate", self._launch_argv, [executable, option])
            menu.append(item)
        self.display_profile_menu = menu
        menu.show_all()
        menu.popup_at_widget(button, Gdk.Gravity.SOUTH_WEST, Gdk.Gravity.NORTH_WEST,
                             Gtk.get_current_event())

    def _collect_settings(self) -> dict[str, object]:
        result: dict[str, object] = {}
        for key, widget in self.widgets.items():
            if key in {"selection-bg", "selection-fg"}:
                continue
            if isinstance(widget, Gtk.ComboBoxText):
                selected = widget.get_active_id()
                if selected is None:
                    raise ValueError(f"Select a value for {key}")
                result[key] = int(selected) if key == "Gtk/ToolbarStyle" else selected
            elif isinstance(widget, Gtk.FontButton):
                result[key] = widget.get_font_name()
            elif isinstance(widget, Gtk.SpinButton):
                result[key] = widget.get_value_as_int()
            elif isinstance(widget, Gtk.CheckButton):
                result[key] = int(widget.get_active())
        bg = _hex_color(self.widgets["selection-bg"].get_rgba())
        fg = _hex_color(self.widgets["selection-fg"].get_rgba())
        result["Gtk/ColorScheme"] = f"selected_bg_color:{bg}\nselected_fg_color:{fg}"
        return result

    def _apply(self, *_args: object) -> None:
        page_number = self.notebook.get_current_page()
        if page_number == 2:
            self._save_sidebar_settings()
            return
        if page_number == 3:
            self._save_news_settings()
            return
        if page_number != 1:
            return
        try:
            settings = self._collect_settings()
            apply_settings(XSETTINGS_PATH, GTK_SETTINGS_PATH, settings)
        except Exception as exc:
            self.status.set_text("Apply failed; previous files were restored when possible.")
            dialog = Gtk.MessageDialog(
                transient_for=self, modal=True, message_type=Gtk.MessageType.ERROR,
                buttons=Gtk.ButtonsType.CLOSE, text="Could not apply desktop settings",
            )
            dialog.format_secondary_text(str(exc))
            dialog.run()
            dialog.destroy()
            return
        self.settings = settings
        self.status.set_text("Settings saved and xsettingsd restarted. Reopen apps that do not update live.")

    def _revert(self, *_args: object) -> None:
        page_number = self.notebook.get_current_page()
        if page_number == 2:
            self._reload_sidebar_settings()
            return
        if page_number == 3:
            self._reload_news_settings()
            return
        if page_number != 1:
            return
        try:
            self.settings = _read_initial_settings()
            for key, widget in self.widgets.items():
                if key in {"selection-bg", "selection-fg", "Gtk/ColorScheme"}:
                    continue
                value = self.settings[key]
                if isinstance(widget, Gtk.ComboBoxText):
                    selected = str(value)
                    if widget.get_active_id() != selected and widget.set_active_id(selected) is False:
                        widget.append(selected, f"{selected} (current)")
                        widget.set_active_id(selected)
                elif isinstance(widget, Gtk.FontButton):
                    widget.set_font_name(str(value))
                elif isinstance(widget, Gtk.SpinButton):
                    widget.set_value(int(value))
                elif isinstance(widget, Gtk.CheckButton):
                    widget.set_active(bool(int(value)))
            scheme = str(self.settings["Gtk/ColorScheme"])
            for key, name, fallback in (("selection-bg", "selected_bg_color", "#3584e4"),
                                        ("selection-fg", "selected_fg_color", "#ffffff")):
                color = Gdk.RGBA()
                color.parse(_color_from_scheme(scheme, name, fallback))
                self.widgets[key].set_rgba(color)
            self.status.set_text("Unsaved changes reverted.")
        except Exception as exc:
            self.status.set_text(f"Could not reload settings: {exc}")

    def _launch_tool(self, button: Gtk.Button, executable: str) -> None:
        self._launch_argv(button, [executable])

    def _launch_argv(self, _button: Gtk.Widget, argv: list[str]) -> None:
        try:
            subprocess.Popen(argv, stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
        except OSError as exc:
            dialog = Gtk.MessageDialog(
                transient_for=self, modal=True, message_type=Gtk.MessageType.ERROR,
                buttons=Gtk.ButtonsType.CLOSE, text=f"Could not launch {Path(argv[0]).name}",
            )
            dialog.format_secondary_text(str(exc))
            dialog.run()
            dialog.destroy()


def main() -> int:
    try:
        window = ControlCenter()
    except Exception as exc:
        print(f"desktop-control-center: {exc}", file=sys.stderr)
        return 1
    window.show_all()
    Gtk.main()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
