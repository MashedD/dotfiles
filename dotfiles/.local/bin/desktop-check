#!/usr/bin/env sh
# Read-only health report for the active Awesome desktop.
set -u
verbose=false
runtime=false
usage() {
  printf '%s\n' 'Usage: desktop-check [--verbose] [--runtime]' \
    'Read-only checks; --verbose shows successful checks, --runtime also checks the active X11 session.'
}
if [ "$#" -gt 2 ]; then usage >&2; exit 64; fi
for option do
  case "$option" in
    --verbose) if "$verbose"; then usage >&2; exit 64; fi; verbose=true ;;
    --runtime) if "$runtime"; then usage >&2; exit 64; fi; runtime=true ;;
    --help|-h) if [ "$#" -eq 1 ]; then usage; exit 0; else usage >&2; exit 64; fi ;;
    *) usage >&2; exit 64 ;;
  esac
done
required_commands='awesome awesome-client picom pgrep xrandr xset xss-lock i3lock maim xclip xdotool snixembed dunst dunstify dmenu pcmanfm xsettingsd lxqt-policykit-agent kitty xdg-terminal-exec xfce4-appfinder pavucontrol playerctl desktop-control-center fc-match flock setsid logger dbus-update-activation-environment wpctl brightnessctl jq curl python3 timeout'
optional_commands='firefox audacious gajim keepassxc xdpyinfo magick arandr nm-connection-editor solaar btop htop amdgpu_top xfce4-taskmanager blueman-manager xfce4-power-manager-settings'
failures=0
warnings=0
ok() { if "$verbose"; then printf 'OK       %s\n' "$*"; fi; }
fail() { failures=$((failures + 1)); printf 'MISSING/FAILED %s\n' "$*"; }
warn() { warnings=$((warnings + 1)); printf 'WARNING  %s\n' "$*"; }
check_commands() {
  label=$1
  for command_name in $2; do
    if command -v "$command_name" >/dev/null 2>&1; then
      ok "$label $command_name"
    elif [ "$label" = required ]; then
      fail "required command: $command_name"
    else
      warn "optional command: $command_name"
    fi
  done
}
check_file() {
  if [ -f "$2" ]; then ok "$1 $2"; else fail "$1 $2"; fi
}
runtime_process() {
  name=$1
  pattern=$2
  optional=$3
  if pgrep -u "$runtime_uid" -f "$pattern" >/dev/null 2>&1; then
    ok "runtime service $name"
  elif [ "$optional" = true ]; then
    warn "optional runtime service not running: $name"
  else
    fail "required runtime service not running: $name"
  fi
}
check_runtime() {
  if [ -z "${DISPLAY:-}" ]; then
    warn 'runtime checks skipped: DISPLAY is not set'
    return
  fi
  if output=$(timeout 3s xset -q 2>&1); then
    ok "X11 display reachable: $DISPLAY"
  else
    status=$?; fail "X11 display unavailable: $DISPLAY (exit $status)"
    printf '%s\n' "${output:-No diagnostic output was produced.}"
  fi
  if output=$(timeout 3s awesome-client 'return awesome.version' 2>&1); then
    ok 'Awesome runtime query succeeded'
  else
    status=$?; fail "Awesome runtime query failed (exit $status)"
    printf '%s\n' "${output:-No diagnostic output was produced.}"
  fi
  runtime_uid=$(id -u 2>/dev/null) || { fail 'cannot determine current user id for service checks'; return; }
  runtime_process picom '(^|/)picom([[:space:]]|$)' false
  runtime_process dunst '(^|/)dunst([[:space:]]|$)' false
  runtime_process lxqt-policykit-agent '(^|/)lxqt-policykit-agent([[:space:]]|$)' false
  runtime_process xss-lock '(^|/)xss-lock([[:space:]]|$)' false
  if command -v snixembed >/dev/null 2>&1; then
    runtime_process snixembed '(^|/)snixembed([[:space:]]|$)' true
  fi
}
validate() {
  command -v "$1" >/dev/null 2>&1 || return 0
  if output=$("$@" 2>&1); then
    ok "validator: $*"
    if "$verbose" && [ -n "$output" ]; then printf '%s\n' "$output"; fi
  else
    status=$?
    fail "validator: $* (exit $status)"
    printf '%s\n' "${output:-No diagnostic output was produced.}"
  fi
}
printf '%s\n' 'Awesome desktop check (read-only)'
check_commands required "$required_commands"
check_commands optional "$optional_commands"
config_home=${XDG_CONFIG_HOME:-$HOME/.config}
data_home=${XDG_DATA_HOME:-$HOME/.local/share}
for config in awesome/rc.lua awesome/panel.lua awesome/autostart awesome/news-feeds picom/picom.conf X11/xinitrc xdg-terminals.list xsettingsd/xsettingsd.conf; do
  check_file config "$config_home/$config"
done
xsettings_config="$config_home/xsettingsd/xsettingsd.conf"
if [ -f "$xsettings_config" ]; then
  gtk_theme=no gtk_blue=no gtk_icons=no gtk_cursor=no
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      'Net/ThemeName "Adwaita"'|'Net/ThemeName "Adwaita-dark"') gtk_theme=yes ;;
      'Net/IconThemeName "Breeze"') gtk_icons=yes ;;
      'Gtk/CursorThemeName "Adwaita"') gtk_cursor=yes ;;
      *'selected_bg_color:#3584e4'*) gtk_blue=yes ;;
    esac
  done < "$xsettings_config"
  if [ "$gtk_theme" = yes ]; then ok 'GTK theme Adwaita (light or dark)'
  else fail "GTK theme: expected Adwaita or Adwaita-dark in $xsettings_config"; fi
  if [ "$gtk_blue" = yes ]; then ok 'GTK selection accent Adwaita blue'
  else fail "GTK selection accent: expected #3584e4 in $xsettings_config"; fi
  if [ "$gtk_icons" = yes ]; then ok 'GTK icon theme Breeze'
  else fail "GTK icon theme: expected Breeze in $xsettings_config"; fi
  if [ "$gtk_cursor" = yes ]; then ok 'GTK cursor theme Adwaita'
  else fail "GTK cursor theme: expected Adwaita in $xsettings_config"; fi
fi
terminal_list="$config_home/xdg-terminals.list"
if [ -f "$terminal_list" ]; then
  selected_terminal=''
  if IFS= read -r selected_terminal < "$terminal_list" && [ "$selected_terminal" = kitty.desktop ]; then
    ok "default terminal kitty.desktop ($terminal_list)"
  else
    fail "default terminal: expected kitty.desktop as the first entry in $terminal_list (found ${selected_terminal:-<empty>})"
  fi
fi
validate awesome -k -c "$config_home/awesome/rc.lua"
validate picom --config "$config_home/picom/picom.conf" --diagnostics
check_file asset "$HOME/.local/share/wallpapers/aurora-cabin.png"
check_file asset "$data_home/icons/hicolor/32x32/apps/tux-start.png"
check_file app "$HOME/.local/bin/desktop-control-center"
check_file app "$HOME/.local/lib/desktop_control_center/settings.py"
check_file app "$data_home/applications/desktop-control-center.desktop"
if command -v fc-match >/dev/null 2>&1; then
  if font=$(fc-match -f '%{family}\n' 'Microsoft Sans Serif' 2>&1); then
    case "$font" in
      *'Microsoft Sans Serif'*) ok 'font Microsoft Sans Serif' ;;
      *'Liberation Sans'*) warn 'font fallback: Liberation Sans (Microsoft Sans Serif is not installed)' ;;
      *) fail "font Microsoft Sans Serif or Liberation Sans (matched $font)" ;;
    esac
  else
    status=$?; fail "font probe Microsoft Sans Serif (exit $status): ${font:-No diagnostic output was produced.}"
  fi
  if font=$(fc-match -f '%{family}\n' 'FiraCode Nerd Font' 2>&1); then
    case "$font" in
      *'FiraCode Nerd Font'*) ok 'font FiraCode Nerd Font' ;;
      *) fail "font FiraCode Nerd Font (matched $font)" ;;
    esac
  else
    status=$?; fail "font probe FiraCode Nerd Font (exit $status): ${font:-No diagnostic output was produced.}"
  fi
fi
bin_root=${DESKTOP_HELPER_ROOT:-$HOME/.local/bin}
for helper in desktop-lock desktop-display desktop-screenshot desktop-battery-watch desktop-brightness desktop-volume desktop-news; do
  if [ -x "$bin_root/$helper" ]; then ok "helper $bin_root/$helper"; else fail "helper $bin_root/$helper"; fi
done
if "$runtime"; then check_runtime; fi
printf 'Summary: %s required failure(s), %s warning(s).\n' "$failures" "$warnings"
[ "$failures" -eq 0 ]
