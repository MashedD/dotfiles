z   Compress folder to .tar.gz
    CURRENT_FOLDER_NAME=$(basename %d /)
    echo -n "Name of the compressed file (without extension) [$CURRENT_FOLDER_NAME]: "
    read ARCHIVE_NAME
    [ "$ARCHIVE_NAME"x = x ] && ARCHIVE_NAME="$CURRENT_FOLDER_NAME"
    cd ..
    tar cf - "$CURRENT_FOLDER_NAME" | gzip -f9 > "$ARCHIVE_NAME.tar.gz"
    echo "../$ARCHIVE_NAME.tar.gz created"

x   Compress folder to .zip with password
    CURRENT_FOLDER_NAME=$(basename %d /)
    echo -n "Name of the compressed file (without extension) [$CURRENT_FOLDER_NAME]: "
    read ARCHIVE_NAME
    [ "$ARCHIVE_NAME"x = x ] && ARCHIVE_NAME="$CURRENT_FOLDER_NAME"
    zip -re "../$ARCHIVE_NAME.zip" .

