# Square-edged, Aero-blue notifications for the Awesome desktop.

[global]
    follow = keyboard
    width = 360
    height = (0, 220)
    origin = top-center
    offset = (0, 40)
    notification_limit = 5

    font = Microsoft Sans Serif 12
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    ellipsize = end

    frame_width = 2
    frame_color = "#73a7c5"
    separator_height = 1
    separator_color = "#527b96"
    padding = 6
    horizontal_padding = 8
    text_icon_padding = 6
    corner_radius = 0

    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_corner_radius = 0

    icon_position = left
    min_icon_size = 16
    max_icon_size = 32

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#183d5b"
    foreground = "#b8c5d6"
    frame_color = "#536a82"
    highlight = "#9cddd4"
    timeout = 8

[urgency_normal]
    background = "#183d5b"
    foreground = "#e0e8f2"
    frame_color = "#73a7c5"
    highlight = "#a8f0bd"
    timeout = 10

[urgency_critical]
    background = "#183d5b"
    foreground = "#f2fffb"
    frame_color = "#ff8e89"
    highlight = "#ff8e89"
    timeout = 0
