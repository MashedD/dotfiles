# lxpanel <profile> config file. Manually editing is not recommended.
# Use preference dialog in lxpanel to adjust config when you can.

Global {
  edge=top
  align=left
  margin=0
  widthtype=percent
  width=100
  height=30
  transparent=0
  tintcolor=#000000
  alpha=0
  setdocktype=1
  setpartialstrut=1
  usefontcolor=1
  fontcolor=#000000
  background=0
}
Plugin {
  type=menu
  Config {
    image=/home/user/.themes/Chicago95/misc/GTK2_start_buttons/tux_30px.png
    system {
    }
    separator {
    }
    item {
      command=run
    }
    separator {
    }
    item {
      image=gnome-logout
      command=logout
    }
  }
}
Plugin {
  type=separator
  Config {
  }
}
Plugin {
  type=pager
  Config {
  }
}
Plugin {
  type=separator
  Config {
  }
}
Plugin {
  type=taskbar
  expand=1
  Config {
    tooltips=1
    IconsOnly=0
    AcceptSkipPager=1
    ShowIconified=1
    ShowMapped=1
    ShowAllDesks=0
    ShowSquareBrackets=0
    UseMouseWheel=1
    UseUrgencyHint=1
    FlatButton=0
    MaxTaskWidth=180
    spacing=1
  }
}
Plugin {
  type=cpu
  Config {
  }
}
Plugin {
  type=batt
  Config {
    HideIfNoBattery=1
    BatteryNumber=1
    BatteryNumberHide=0
    ShowExtendedInformation=1
  }
}
Plugin {
  type=volume
  Config {
    MixerCommand=pavucontrol
  }
}
Plugin {
  type=tray
  Config {
  }
}
Plugin {
  type=dclock
  Config {
    ClockFmt=%R
    TooltipFmt=%A, %d %B %Y
    BoldFont=1
    IconOnly=0
    CenterText=0
  }
}
