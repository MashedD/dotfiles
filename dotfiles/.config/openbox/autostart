#
# These things are run when an Openbox X Session is started.
# You may place a similar script in $HOME/.config/openbox/autostart
# to run user-specific things.
#

# If you want to use GNOME config tools...
#
#if test -x /usr/lib/openbox/gnome-settings-daemon >/dev/null; then
#  /usr/lib/openbox/gnome-settings-daemon &
#elif which gnome-settings-daemon >/dev/null 2>&1; then
#  gnome-settings-daemon &
#fi

# If you want to use XFCE config tools...
#
#xfce-mcs-manager &

if command -v xsettingsd >/dev/null 2>&1; then
  xsettingsd -c "$HOME/.config/xsettingsd/xsettingsd.conf" &
fi

"$HOME/.local/bin/openbox-display"

tint2 -c "$HOME/.config/tint2/tint2rc" &
snixembed &
if command -v dunst >/dev/null 2>&1; then
  dunst -conf "$HOME/.config/dunst/dunstrc" &
fi
if command -v lxqt-policykit-agent >/dev/null 2>&1; then
  lxqt-policykit-agent &
fi
if command -v clipmenud >/dev/null 2>&1; then
  clipmenud &
fi
if command -v xss-lock >/dev/null 2>&1 && command -v i3lock >/dev/null 2>&1; then
  xss-lock --transfer-sleep-lock -- "$HOME/.local/bin/openbox-lock" &
fi
"$HOME/.local/bin/openbox-battery-watch" &
pcmanfm --desktop --set-wallpaper "$HOME/.local/share/wallpapers/win98-teal.svg" --wallpaper-mode=stretch &
