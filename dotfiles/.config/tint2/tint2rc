# Win95 shell with Matrix-green selection accents.
# Requires tint2 16.x or newer.

# Backgrounds
rounded = 0
border_width = 1
background_color = #c0c0c0 100
border_color = #ffffff 100
background_color_hover = #c0c0c0 100
border_color_hover = #00ff41 100
background_color_pressed = #a0a0a0 100
border_color_pressed = #00aa33 100

rounded = 0
border_width = 1
background_color = #dfdfdf 100
border_color = #ffffff 100

rounded = 0
border_width = 1
background_color = #001a00 100
border_color = #00ff41 100

rounded = 0
border_width = 1
background_color = #808080 100
border_color = #000000 100

# Panel
panel_items = TSC
panel_size = 100% 30
panel_margin = 0 0
panel_padding = 3 2 3
panel_background_id = 1
wm_menu = 1
panel_dock = 0
panel_pivot_struts = 0
panel_position = top center horizontal
panel_layer = top
panel_monitor = all
panel_shrink = 0
autohide = 0
strut_policy = follow_size
disable_transparency = 1

# Taskbar
taskbar_mode = single_desktop
taskbar_hide_if_empty = 0
taskbar_padding = 0 0 3
taskbar_background_id = 0
taskbar_active_background_id = 0
taskbar_name = 0
taskbar_distribute_size = 0
taskbar_sort_order = none
task_align = left

# Tasks
task_text = 1
task_icon = 1
task_centered = 0
urgent_nb_of_blink = 8
task_maximum_size = 180 24
task_padding = 6 2 4
task_font = Microsoft Sans Serif 8
task_font_color = #000000 100
task_background_id = 2
task_active_font_color = #00ff41 100
task_active_background_id = 3
task_urgent_font_color = #00ff41 100
task_urgent_background_id = 4
task_iconified_font_color = #404040 100
task_iconified_background_id = 1
mouse_left = toggle_iconify
mouse_middle = close
mouse_right = toggle
mouse_scroll_up = prev_task
mouse_scroll_down = next_task

# System tray
systray = 1
systray_padding = 4 2 4
systray_background_id = 2
systray_sort = ascending
systray_icon_size = 16
systray_icon_asb = 100 0 0

# Clock
time1_format = %H:%M
time2_format = %a %d %b
time1_font = Microsoft Sans Serif Bold 8
time2_font = Microsoft Sans Serif 7
clock_font_color = #000000 100
clock_padding = 10 1
clock_background_id = 2
clock_tooltip = %A, %d %B %Y
clock_lclick_command = xclock
clock_rclick_command = orage

# Tooltip
tooltip = 1
tooltip_padding = 4 3
tooltip_show_timeout = 0.5
tooltip_hide_timeout = 0.2
tooltip_background_id = 2
tooltip_font = Microsoft Sans Serif 8
tooltip_font_color = #000000 100

# Battery and executor defaults stay disabled unless added to panel_items.
battery = 0
launcher_padding = 0 0 0
