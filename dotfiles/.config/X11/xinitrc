#!/bin/sh
# Shared startx entry point (also used via XINITRC from .bash_profile).
config_home=${XDG_CONFIG_HOME:-$HOME/.config}
export XDG_CONFIG_HOME="$config_home"

# Retain the distribution's X11 environment hooks.
if [ -d /etc/X11/xinit/xinitrc.d ]; then
    for hook in /etc/X11/xinit/xinitrc.d/?*.sh; do
        [ ! -x "$hook" ] || . "$hook"
    done
fi
export XDG_CURRENT_DESKTOP=awesome
export XDG_SESSION_DESKTOP=awesome
export XDG_SESSION_TYPE=x11
# Share GNOME Keyring/Gajim's systemd user bus, never dbus-run-session.
if [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus"
fi
if command -v xrdb >/dev/null 2>&1 && [ -f "$config_home/X11/Xresources" ]; then
    xrdb -merge "$config_home/X11/Xresources"
fi
if command -v setxkbmap >/dev/null 2>&1; then
    setxkbmap pl
fi
if ! command -v awesome >/dev/null 2>&1; then
    printf '%s\n' 'awesome is not installed; install it before starting this session.' >&2
    exit 1
fi
awesome -k -c "$config_home/awesome/rc.lua" || exit 1
exec awesome -c "$config_home/awesome/rc.lua"
